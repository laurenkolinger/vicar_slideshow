# Settings for one machine only (see README, "Point the tool at your content").
settings.local.json

# Generated caches, including video thumbnails.
.cache/

# Content never lives in git. It lives in the content folder named by settings.json.
# No trailing slash, so a link of this name is ignored too.
slideshow/slideshow_media
slideshow/_thumbs/

# Local leftovers from before the content folder moved out of the repository.
# They stay on disk, untracked, and the tool does not use them.
slideshow/captions.csv
slideshow/captions.numbers
slideshow/_manifest.json

# Caches / envs / OS + editor cruft.
env/
__pycache__/
*.pyc
*.pyo
.DS_Store
.idea/
.vscode/
*.swp
